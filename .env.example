# Copy this file to .env and fill in your real keys.
# .env is gitignored — never commit secrets.

# Anthropic API key for the Claude advisor (claude-opus-4-7).
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# the-odds-api.com key for tournament + per-player goalscorer odds.
# Get one at https://the-odds-api.com/
ODDS_API_KEY=...

# Gmail SMTP for the 90-minute pre-deadline email (scripts/email_picks.py).
# EMAIL_FROM   the Gmail address that owns the app password
# EMAIL_PASSWORD  16-char Gmail app password (NOT the account password). Create
#   one at https://myaccount.google.com/apppasswords — 2FA must be enabled.
# EMAIL_TO     recipient address (or comma-separated list)

